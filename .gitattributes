* text=auto

# Force all files to LF for cross-platform consistency
* text eol=lf

# Binary files
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary

# GitHub languages
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf