/* pages/menu/index.wxss */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F6F6F6;
}

.header {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.date-picker {
  display: flex;
  align-items: center;
  min-height: 44rpx;
  margin-bottom: 12rpx;
}

.date-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
  margin-left: 8rpx;
}

.meal-type-selector {
  display: flex;
  gap: 16rpx;
}

.meal-type-btn {
  flex: 1;
  text-align: center;
  /* 满足 U-003：触控目标至少 44 × 44 CSS 像素 */
  min-height: 88rpx;
  line-height: 88rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666666;
}

.meal-type-btn.active {
  background: #86C8A0;
  color: #FFFFFF;
  font-weight: 500;
}

.category-bar {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.category-item {
  display: inline-block;
  /* U-003 触控高度：内边距上下 16rpx + 文本 28rpx ≈ 60rpx */
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #666666;
  border-bottom: 4rpx solid transparent;
  min-height: 44rpx;
  line-height: 44rpx;
}

.category-item.active {
  color: #86C8A0;
  border-bottom-color: #86C8A0;
  font-weight: 500;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 加载条：不阻塞分类切换 */
.loading-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  color: #999999;
  font-size: 26rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: #86C8A0;
  border-radius: 50%;
  opacity: 0.4;
  animation: pulse 1.2s infinite ease-in-out;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.loading-text {
  margin-left: 12rpx;
}

@keyframes pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.85); }
  40% { opacity: 1; transform: scale(1); }
}

.state-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
  gap: 16rpx;
  padding: 0 48rpx;
  text-align: center;
}

.error-icon,
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.error-text {
  color: #E64340;
  font-size: 28rpx;
  line-height: 1.5;
}

.empty-title {
  font-size: 30rpx;
  color: #666666;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.error-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #BBBBBB;
  background: #F7F7F7;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.error-meta-label {
  color: #999999;
}

.error-meta-value {
  color: #666666;
  font-family: monospace;
  margin: 0 4rpx;
}

.error-meta-hint {
  color: #86C8A0;
}

.retry-btn {
  margin-top: 16rpx;
  background: #86C8A0;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  min-width: 200rpx;
}

.dish-list {
  flex: 1;
  padding: 16rpx 24rpx 200rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  /* U-003 触控高度：图片 120rpx 主导 */
  min-height: 120rpx;
}

.dish-card.selected {
  border: 2rpx solid #86C8A0;
  background: #F0FAF4;
}

.dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #EEEEEE;
}

.dish-image image {
  width: 100%;
  height: 100%;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.dish-desc {
  font-size: 24rpx;
  color: #999999;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-check {
  margin-left: 16rpx;
}

.check-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
}

.check-icon.checked {
  background: #86C8A0;
  border-color: #86C8A0;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
}

.basket-summary {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.basket-count {
  font-size: 40rpx;
  font-weight: 600;
  color: #86C8A0;
}

.basket-label {
  font-size: 28rpx;
  color: #666666;
}

.confirm-btn {
  background: #86C8A0;
  color: #FFFFFF;
  font-size: 30rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  min-width: 200rpx;
}

.confirm-btn[disabled] {
  background: #CCCCCC;
  color: #FFFFFF;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 600rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-body {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.modal-actions button {
  flex: 1;
  min-height: 88rpx;
}