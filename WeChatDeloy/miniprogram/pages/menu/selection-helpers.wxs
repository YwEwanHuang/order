// pages/menu/selection-helpers.wxs
// WXS 模块：提供选择篮相关的响应式辅助函数
// 选择篮状态通过 page data 传入，避免小程序模板函数非响应式调用问题

var SELECTION_STATES = {};

function setSelection(pageId, selection) {
  SELECTION_STATES[pageId] = selection;
}

function getSelection(pageId) {
  return SELECTION_STATES[pageId] || { items: [] };
}

function isSelected(pageId, dishId) {
  var selection = getSelection(pageId);
  return selection.items.some(function(item) {
    return item.dishId === dishId;
  });
}

function getSelectedCount(pageId) {
  var selection = getSelection(pageId);
  return selection.items.length;
}

function clearSelection(pageId) {
  SELECTION_STATES[pageId] = { date: '', mealType: '', items: [] };
}

module.exports = {
  setSelection: setSelection,
  getSelection: getSelection,
  isSelected: isSelected,
  getSelectedCount: getSelectedCount,
  clearSelection: clearSelection,
};