<!-- pages/menu/index.wxml -->
<view class="page">
  <!-- 顶部：日期 + 餐次选择 -->
  <view class="header">
    <picker
      mode="date"
      value="{{selection.date}}"
      start="{{dateBounds.start}}"
      end="{{dateBounds.end}}"
      bindchange="onDateChange"
    >
      <view class="date-picker">
        <text class="date-label">{{selection.date}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>

    <view class="meal-type-selector">
      <view
        wx:for="{{['breakfast', 'lunch', 'dinner']}}"
        wx:key="*this"
        class="meal-type-btn {{selection.mealType === item ? 'active' : ''}}"
        data-value="{{item}}"
        bindtap="onMealTypeChange"
        role="button"
        aria-label="{{item === 'breakfast' ? '早餐' : item === 'lunch' ? '午餐' : '晚餐'}}"
      >
        {{item === 'breakfast' ? '早餐' : item === 'lunch' ? '午餐' : '晚餐'}}
      </view>
    </view>
  </view>

  <!-- 分类栏（始终可见，切换不丢失已选） -->
  <scroll-view scroll-x class="category-bar" enable-flex>
    <view
      wx:for="{{['hot', 'cold', 'soup', 'staple', 'dessert']}}"
      wx:key="*this"
      class="category-item {{currentCategory === item ? 'active' : ''}}"
      data-category="{{item}}"
      bindtap="onCategoryChange"
      role="tab"
      aria-selected="{{currentCategory === item}}"
      aria-label="{{item === 'hot' ? '热菜' : item === 'cold' ? '凉菜' : item === 'soup' ? '汤类' : item === 'staple' ? '主食' : '甜点'}}"
    >
      {{item === 'hot' ? '热菜' : item === 'cold' ? '凉菜' : item === 'soup' ? '汤类' : item === 'staple' ? '主食' : '甜点'}}
    </view>
  </scroll-view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 加载状态（顶部条形，不阻塞分类切换） -->
    <view wx:if="{{loading}}" class="loading-bar" role="status" aria-live="polite">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <text class="loading-text">加载中</text>
    </view>

    <!-- 错误状态 -->
    <view wx:elif="{{error}}" class="state-view" role="alert">
      <text class="error-icon">⚠</text>
      <text class="error-text">{{error}}</text>
      <view wx:if="{{errorRequestId}}" class="error-meta" bindtap="onCopyRequestId">
        <text class="error-meta-label">请求 ID：</text>
        <text class="error-meta-value">{{errorRequestId}}</text>
        <text class="error-meta-hint">（点击复制，反馈给管理员）</text>
      </view>
      <button class="retry-btn" bindtap="loadDishes" size="mini">重新加载</button>
    </view>

    <!-- 空状态：分类内为空 -->
    <view wx:elif="{{initialLoaded && dishes.length === 0}}" class="state-view">
      <text class="empty-icon">🍽</text>
      <text class="empty-title">这个分类还没有菜品</text>
      <text class="empty-desc">切换其他分类看看，或下拉刷新</text>
    </view>

    <!-- 菜品列表（支持下拉刷新） -->
    <scroll-view
      wx:else
      scroll-y
      class="dish-list"
      refresher-enabled="{{true}}"
      refresher-triggered="{{loading}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view
        wx:for="{{dishes}}"
        wx:key="id"
        class="dish-card {{item.selected ? 'selected' : ''}}"
        data-dish="{{item}}"
        bindtap="onDishTap"
        role="button"
        aria-pressed="{{item.selected}}"
        aria-label="{{item.name}}{{item.selected ? '，已选' : '，未选'}}"
      >
        <view class="dish-image">
          <image src="{{item.imageUrl || '/images/default-goods-image.png'}}" mode="aspectFill" />
        </view>
        <view class="dish-info">
          <text class="dish-name">{{item.name}}</text>
          <text wx:if="{{item.description}}" class="dish-desc">{{item.description}}</text>
        </view>
        <view class="dish-check">
          <view class="check-icon {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部选择篮 -->
  <view class="bottom-bar">
    <view class="basket-summary">
      <text class="basket-count">{{selectedCount}}</text>
      <text class="basket-label">道菜已选</text>
    </view>
    <button
      class="confirm-btn"
      bindtap="onGoToConfirm"
      disabled="{{selectedCount === 0}}"
    >
      去确认
    </button>
  </view>

  <!-- 切换确认弹窗 -->
  <view wx:if="{{showSwitchConfirm}}" class="modal-mask" bindtap="onCancelSwitch">
    <view class="modal-content" catchtap="">
      <text class="modal-title">切换将清空已选菜品</text>
      <text class="modal-body">当前选择尚未提交，切换日期或餐次会清空选择篮。确定要切换吗？</text>
      <view class="modal-actions">
        <button bindtap="onCancelSwitch">取消</button>
        <button type="primary" bindtap="onConfirmSwitch">确定切换</button>
      </view>
    </view>
  </view>
</view>