.dishes { display: flex; flex-direction: column; height: 100vh; background: #F6F6F6; box-sizing: border-box; }
.state { text-align: center; padding: 96rpx 0; color: #999; }
.state.error { color: #c00; }

.main { flex: 1; display: flex; min-height: 0; }
.sidebar { width: 160rpx; background: #ededed; }
.cat-item { padding: 28rpx 16rpx; font-size: 28rpx; color: #555; text-align: center; border-left: 6rpx solid transparent; }
.cat-active { background: #F6F6F6; color: #333; font-weight: bold; border-left-color: #86C8A0; }

.grid-scroll { flex: 1; padding: 0 24rpx; box-sizing: border-box; }
.grid-row-title { padding: 24rpx 0 12rpx; font-size: 26rpx; color: #999; font-weight: bold; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding-bottom: 16rpx; }
.card { position: relative; width: 100%; background: #fff; border-radius: 16rpx; padding: 16rpx; box-sizing: border-box; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); display: flex; align-items: center; gap: 16rpx; }
.card-img { width: 120rpx; height: 120rpx; flex-shrink: 0; aspect-ratio: 1 / 1; background: #f5f5f5; border-radius: 12rpx; }
.card-name { font-size: 28rpx; color: #333; padding: 0; flex: 1; text-align: left; }
.card-meta { font-size: 22rpx; color: #999; padding: 4rpx 0 8rpx; }
.card-inactive .card-name { color: #999; text-decoration: line-through; }
.card-inactive .card-img { opacity: 0.5; }
.card-actions { display: flex; gap: 16rpx; flex-shrink: 0; }
.card-link { font-size: 24rpx; color: #86C8A0; padding: 4rpx 12rpx; }
.card-link.danger { color: #c00; }
.card-add { display: flex; align-items: center; background: #f5f5f5; box-shadow: none; border: 2rpx dashed #ddd; }
.card-add-plus { font-size: 56rpx; color: #ccc; padding: 0; width: 120rpx; height: 120rpx; flex-shrink: 0; line-height: 120rpx; text-align: center; }
.bottom-spacer { height: 32rpx; }

.modal { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: flex-end; z-index: 10; }
.sheet { background: #fff; width: 100%; padding: 32rpx; border-top-left-radius: 24rpx; border-top-right-radius: 24rpx; box-sizing: border-box; }
.sheet-title { font-size: 32rpx; margin-bottom: 24rpx; text-align: center; }
.sheet input { width: 100%; padding: 16rpx; background: #f5f5f5; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; margin-bottom: 24rpx; }
.cat-pick { display: flex; gap: 16rpx; flex-wrap: wrap; margin-bottom: 32rpx; }
.cat-opt { padding: 12rpx 24rpx; border-radius: 24rpx; background: #f5f5f5; font-size: 26rpx; }
.cat-opt.selected { background: #86C8A0; color: #fff; }
.img-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 32rpx; padding: 16rpx; background: #f5f5f5; border-radius: 12rpx; }
.img-preview { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #fff; flex-shrink: 0; }
.img-empty { width: 120rpx; height: 120rpx; line-height: 120rpx; text-align: center; color: #999; font-size: 24rpx; background: #fff; border-radius: 12rpx; flex-shrink: 0; border: 2rpx dashed #ddd; }
.img-btn { background: #fff; color: #86C8A0; border: 2rpx solid #86C8A0; border-radius: 24rpx; font-size: 24rpx; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; margin: 0; }
.img-btn.danger { color: #c00; border-color: #c00; }
.img-btn[disabled] { color: #ccc; border-color: #ccc; }
.sort-list { max-height: 60vh; overflow-y: auto; margin-bottom: 32rpx; }
.sort-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.sort-name { flex: 1; font-size: 28rpx; color: #333; }
.sort-actions { display: flex; gap: 12rpx; }
.sort-btn { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; background: #f5f5f5; border-radius: 12rpx; font-size: 32rpx; color: #555; }
.sheet-actions { display: flex; justify-content: space-between; }
.link { font-size: 26rpx; color: #555; padding: 8rpx 16rpx; }
.primary-link { color: #86C8A0; font-weight: bold; }
.error { color: #c00; font-size: 24rpx; margin-top: 16rpx; text-align: center; }