/* pages/admin/dishes/index.wxss */

.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  gap: 16rpx;
}

.sub {
  font-size: 26rpx;
  color: #BBBBBB;
}

.error-text {
  color: #E64340;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.dish-category {
  font-size: 24rpx;
  color: #86C8A0;
}

.inactive-tag {
  font-size: 22rpx;
  color: #E64340;
  background: #FFF0F0;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.dish-actions {
  display: flex;
  gap: 12rpx;
}