<!-- pages/admin/dish-edit/index.wxml -->
<view class="page">
  <view class="form">
    <!-- 菜品图片 -->
    <view class="form-item">
      <view class="form-label">菜品图片</view>
      <view class="image-picker" bindtap="onChooseImage">
        <image
          wx:if="{{imageTempPath}}"
          src="{{imageTempPath}}"
          mode="aspectFill"
          class="preview-image"
        />
        <view wx:else class="placeholder">
          <text>+</text>
          <text class="tip">点击上传图片</text>
        </view>
      </view>
    </view>

    <!-- 菜品名称 -->
    <view class="form-item">
      <view class="form-label">名称 <text class="required">*</text></view>
      <input
        class="form-input"
        placeholder="输入菜品名称（1-30字）"
        value="{{name}}"
        maxlength="30"
        bindinput="onNameInput"
      />
    </view>

    <!-- 分类 -->
    <view class="form-item">
      <view class="form-label">分类</view>
      <picker mode="selector" range="{{categories}}" value="{{categories.indexOf(category)}}" bindchange="onCategoryChange">
        <view class="picker-value">{{getCategoryLabel(category)}}</view>
      </picker>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <view class="form-label">描述</view>
      <textarea
        class="form-textarea"
        placeholder="输入菜品描述（可选，最多100字）"
        value="{{description}}"
        maxlength="100"
        bindinput="onDescriptionInput"
      />
    </view>

    <!-- 错误提示 -->
    <view wx:if="{{error}}" class="error-tip">
      <text>{{error}}</text>
    </view>

    <!-- 保存按钮 -->
    <button
      class="save-btn"
      type="primary"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="onSave"
    >
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>