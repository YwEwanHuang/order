<!-- pages/admin/dish-edit/index.wxml -->
<view class="page">
  <view class="form">
    <!-- 菜品图片 -->
    <view class="form-item">
      <view class="form-label">菜品图片</view>
      <view class="image-picker-wrap">
        <!-- 优先展示新选的本地预览；否则展示已有云端图片；都没有显示占位 -->
        <view class="image-picker" bindtap="onChooseImage">
          <image
            wx:if="{{imageTempPath}}"
            src="{{imageTempPath}}"
            mode="aspectFill"
            class="preview-image"
          />
          <image
            wx:elif="{{imageUrl}}"
            src="{{imageUrl}}"
            mode="aspectFill"
            class="preview-image"
          />
          <view wx:else class="placeholder">
            <text>+</text>
            <text class="tip">点击上传图片</text>
          </view>
          <view wx:if="{{uploading}}" class="uploading-mask">
            <text>上传中…</text>
          </view>
        </view>
        <view
          wx:if="{{imageTempPath || imageUrl}}"
          class="image-remove"
          bindtap="onRemoveImage"
          role="button"
          aria-label="移除图片"
        >
          移除
        </view>
      </view>
    </view>

    <!-- 菜品名称 -->
    <view class="form-item">
      <view class="form-label">
        <text>名称 </text>
        <text class="required">*</text>
        <text class="char-count">{{name.length}}/{{30}}</text>
      </view>
      <input
        class="form-input"
        placeholder="输入菜品名称（1-30字）"
        value="{{name}}"
        maxlength="30"
        bindinput="onNameInput"
      />
    </view>

    <!-- 分类 -->
    <view class="form-item">
      <view class="form-label">分类</view>
      <picker
        mode="selector"
        range="{{categoryOptions}}"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="picker-value">{{categoryOptions[categoryIndex]}}</view>
      </picker>
    </view>

    <!-- 排序权重 -->
    <view class="form-item">
      <view class="form-label">排序权重</view>
      <input
        class="form-input"
        type="number"
        placeholder="数字越小越靠前，默认 0"
        value="{{sortOrder}}"
        bindinput="onSortOrderInput"
        aria-label="排序权重"
      />
      <text class="form-hint">数字越小排序越靠前（0-9999）</text>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <view class="form-label">
        <text>描述</text>
        <text class="char-count">{{descriptionCount}}/{{descriptionMaxLength}}</text>
      </view>
      <textarea
        class="form-textarea"
        placeholder="输入菜品描述（可选，最多100字）"
        value="{{description}}"
        maxlength="100"
        bindinput="onDescriptionInput"
      />
    </view>

    <!-- 启停开关 -->
    <view class="form-item form-switch-row">
      <text class="form-label-inline">对用户可见</text>
      <switch checked="{{isActive}}" bindchange="onActiveToggle" color="#86C8A0" />
    </view>

    <!-- 错误提示 -->
    <view wx:if="{{error}}" class="error-tip" role="alert">
      <text>{{error}}</text>
      <view wx:if="{{errorRequestId}}" class="error-meta" bindtap="onCopyRequestId">
        <text class="error-meta-label">请求 ID：</text>
        <text class="error-meta-value">{{errorRequestId}}</text>
        <text class="error-meta-hint">（点击复制）</text>
      </view>
    </view>

    <!-- 保存按钮 -->
    <button
      class="save-btn"
      type="primary"
      loading="{{saving || uploading}}"
      disabled="{{saving || uploading}}"
      bindtap="onSave"
    >
      {{saving ? (uploading ? '上传图片中...' : '保存中...') : '保存'}}
    </button>
  </view>
</view>