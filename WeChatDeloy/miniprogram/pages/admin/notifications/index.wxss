/* pages/admin/notifications/index.wxss */

.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx;
}

.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  gap: 16rpx;
}

.sub {
  font-size: 26rpx;
  color: #BBBBBB;
}

.error-text {
  color: #E64340;
}

.range-bar {
  padding: 0 8rpx 16rpx;
}

.range-text {
  font-size: 26rpx;
  color: #999999;
}

.day-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.day-block {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.day-date {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.day-total {
  font-size: 24rpx;
  color: #999999;
}

.day-empty {
  text-align: center;
  color: #BBBBBB;
  font-size: 24rpx;
  padding: 16rpx 0;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.plan-card {
  background: #F8F8F8;
  border-radius: 8rpx;
  padding: 16rpx;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.plan-meal {
  font-size: 26rpx;
  color: #86C8A0;
  font-weight: 500;
}

.plan-time {
  font-size: 22rpx;
  color: #BBBBBB;
  font-family: monospace;
}

.plan-items {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.plan-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}