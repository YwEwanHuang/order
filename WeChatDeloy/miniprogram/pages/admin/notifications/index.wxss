/* pages/admin/notifications/index.wxss */

.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx;
}

.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  gap: 16rpx;
}

.sub {
  font-size: 26rpx;
  color: #BBBBBB;
}

.error-text {
  color: #E64340;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notification-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notification-content {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.notification-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
}

.notification-status.sent {
  background: #E8F8EE;
  color: #1AAD19;
}

.notification-status.in_app {
  background: #F0F0F0;
  color: #666666;
}

.notification-status.failed {
  background: #FFF0F0;
  color: #E64340;
}