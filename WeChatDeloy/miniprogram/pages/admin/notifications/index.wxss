/* pages/admin/notifications/index.wxss */

.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx;
}

.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  gap: 16rpx;
}

.sub {
  font-size: 26rpx;
  color: #BBBBBB;
}

.error-text {
  color: #E64340;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notification-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notification-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.notification-channel {
  background: #F0F0F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.notification-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.notification-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.notification-sub {
  font-size: 22rpx;
  color: #BBBBBB;
  font-family: monospace;
}

.notification-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notification-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.notification-status.sent {
  background: #E8F8EE;
  color: #1AAD19;
}

.notification-status.pending {
  background: #FFF8E0;
  color: #B58900;
}

.notification-status.no-quota {
  background: #F0F0F0;
  color: #666666;
}

.notification-status.rejected {
  background: #F0F0F0;
  color: #999999;
}

.notification-status.failed {
  background: #FFF0F0;
  color: #E64340;
}

.retry-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  background: #FFFFFF;
  border: 1rpx solid #86C8A0;
  color: #86C8A0;
  border-radius: 24rpx;
}

.retry-btn::after {
  border: none;
}