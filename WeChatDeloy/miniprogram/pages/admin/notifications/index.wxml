<!-- pages/admin/notifications/index.wxml -->
<view class="page">
  <view wx:if="{{loading && notifications.length === 0}}" class="state-view">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{error && notifications.length === 0}}" class="state-view">
    <text class="error-text">{{error}}</text>
    <button bindtap="loadNotifications" size="mini">重试</button>
  </view>

  <view wx:elif="{{notifications.length === 0}}" class="state-view">
    <text>暂无通知记录</text>
    <text class="sub">点菜提交后会显示在这里</text>
  </view>

  <view wx:else class="notification-list">
    <view wx:for="{{notifications}}" wx:key="id" class="notification-card">
      <view class="notification-header">
        <text class="notification-channel">{{item.channelLabel}}</text>
        <text class="notification-date">{{item.dateLabel}}</text>
      </view>
      <view class="notification-body">
        <text class="notification-title">点菜 v{{item.mealPlanVersion}}</text>
        <text class="notification-sub">记录 ID: {{item.mealPlanId}}</text>
      </view>
      <view class="notification-footer">
        <view class="notification-status {{item.statusClass}}">
          <text>{{item.statusLabel}}</text>
        </view>
        <button
          wx:if="{{item.retryable}}"
          size="mini"
          class="retry-btn"
          data-id="{{item.id}}"
          bindtap="onRetryTap"
        >重试</button>
      </view>
    </view>
  </view>
</view>