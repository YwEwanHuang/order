/* pages/meal-plans/index.wxss */

.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx;
}

.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  gap: 16rpx;
}

.sub {
  font-size: 26rpx;
  color: #BBBBBB;
}

.error-text {
  color: #E64340;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.plan-date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.plan-meal-type {
  background: #86C8A0;
  color: #FFFFFF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.plan-meta {
  font-size: 24rpx;
  color: #BBBBBB;
}

.plan-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.plan-item-tag {
  background: #F0FAF4;
  color: #333333;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  border: 1rpx solid #C8E8D0;
}

.plan-note {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
  padding: 8rpx 12rpx;
  background: #F9F9F9;
  border-radius: 6rpx;
}

.plan-actions {
  display: flex;
  justify-content: flex-end;
}

.plan-actions button {
  background: #F0F0F0;
  color: #666666;
  font-size: 26rpx;
}