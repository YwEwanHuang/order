<!-- pages/meal-plans/index.wxml -->
<view class="page">
  <view wx:if="{{loading}}" class="state-view">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="state-view">
    <text class="error-text">{{error}}</text>
    <button bindtap="loadPlans" size="mini">重试</button>
  </view>

  <view wx:elif="{{plans.length === 0}}" class="state-view">
    <text>暂无点菜记录</text>
    <text class="sub">去"点菜"页面开始吧</text>
  </view>

  <view wx:else class="plan-list">
    <view wx:for="{{plans}}" wx:key="id" class="plan-card">
      <view class="plan-header">
        <view class="plan-date-row">
          <text class="plan-date">{{item.date}}</text>
          <text class="plan-meal-type">{{getMealTypeLabel(item.mealType)}}</text>
        </view>
        <view class="plan-meta">v{{item.version}}</view>
      </view>

      <view class="plan-items">
        <text wx:for="{{item.items}}" wx:key="dishId" class="plan-item-tag">
          {{item.name}}
        </text>
      </view>

      <view wx:if="{{item.note}}" class="plan-note">
        <text>{{item.note}}</text>
      </view>

      <view class="plan-actions">
        <button size="mini" bindtap="onModifyTap" data-plan="{{item}}">修改</button>
      </view>
    </view>
  </view>
</view>