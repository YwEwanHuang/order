.select { display: flex; flex-direction: column; height: 100vh; background: #F6F6F6; box-sizing: border-box; }
.title { padding: 24rpx 32rpx; font-size: 32rpx; color: #333; font-weight: bold; }
.state { text-align: center; padding: 96rpx 0; flex: 1; color: #999; }

.main { flex: 1; display: flex; min-height: 0; }

.sidebar { width: 160rpx; background: #ededed; }
.cat-item { padding: 28rpx 16rpx; font-size: 28rpx; color: #555; text-align: center; border-left: 6rpx solid transparent; }
.cat-active { background: #F6F6F6; color: #333; font-weight: bold; border-left-color: #86C8A0; }

.grid-scroll { flex: 1; padding: 0 24rpx; box-sizing: border-box; }
.grid-row-title { padding: 24rpx 0 12rpx; font-size: 26rpx; color: #999; font-weight: bold; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding-bottom: 16rpx; }
.card { position: relative; width: calc((100% - 16rpx) / 2); background: #fff; border-radius: 16rpx; padding: 16rpx; box-sizing: border-box; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-img { width: 100%; aspect-ratio: 1 / 1; background: #f5f5f5; border-radius: 12rpx; }
.card-name { font-size: 28rpx; color: #333; padding: 12rpx 0 0; text-align: center; }
.card-toggle { position: absolute; right: 12rpx; bottom: 12rpx; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; background: #86C8A0; color: #fff; border-radius: 50%; font-size: 36rpx; font-weight: bold; }
.card-selected { background: #E8F5EE; }
.card-selected .card-toggle { background: #E65100; }
.bottom-spacer { height: 32rpx; }

.summary { display: flex; align-items: center; background: #fff; padding: 16rpx 24rpx; border-top: 2rpx solid #eee; gap: 16rpx; }
.summary-left { font-size: 28rpx; color: #333; white-space: nowrap; }
.summary-right { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.summary-note { flex: 1; height: 56rpx; padding: 0 16rpx; background: #F6F6F6; border-radius: 12rpx; font-size: 26rpx; box-sizing: border-box; }
.save-btn { background: #86C8A0; color: #fff; border-radius: 16rpx; font-size: 28rpx; padding: 0 32rpx; height: 64rpx; line-height: 64rpx; margin: 0; }
.save-btn[disabled] { background: #ccc; color: #fff; }

.error { padding: 16rpx 32rpx; color: #c00; font-size: 26rpx; background: #fff; }