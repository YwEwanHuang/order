<!-- pages/selection/confirm.wxml -->
<view class="page">
  <!-- 已选菜品列表 -->
  <view class="section">
    <view class="section-title">已选菜品</view>
    <view class="meal-summary">
      <text class="date">{{selection.date}}</text>
      <text class="meal-type">{{getMealTypeLabel(selection.mealType)}}</text>
      <text class="count">共 {{selection.items.length}} 道</text>
    </view>

    <view class="dish-items">
      <view wx:for="{{selection.items}}" wx:key="dishId" class="dish-item">
        <text class="dish-name">{{item.name}}</text>
        <image wx:if="{{item.imageUrl}}" class="dish-thumb" src="{{item.imageUrl}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注（可选）</view>
    <textarea
      class="note-input"
      placeholder="有什么特殊需求？"
      value="{{note}}"
      maxlength="100"
      bindinput="onNoteInput"
    />
    <text class="char-count">{{note.length}}/100</text>
  </view>

  <!-- 提交结果 -->
  <view wx:if="{{submitResult}}" class="result-banner {{submitResult.success ? 'success' : 'fail'}}">
    <text>{{submitResult.message}}</text>
    <text wx:if="{{submitResult.notificationLabel}}" class="notification-line {{submitResult.notificationClass}}">{{submitResult.notificationLabel}}</text>
    <text wx:if="{{submitResult.success && !submitResult.notificationLabel}}" class="hint">可在"记录"中查看和修改</text>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <button class="back-btn" bindtap="onGoBack">返回</button>
    <button
      class="submit-btn"
      type="primary"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中...' : '确认提交'}}
    </button>
  </view>
</view>