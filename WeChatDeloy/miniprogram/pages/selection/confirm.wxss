/* pages/selection/confirm.wxss */

.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.meal-summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.date {
  font-size: 28rpx;
  color: #666666;
}

.meal-type {
  background: #86C8A0;
  color: #FFFFFF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.count {
  font-size: 26rpx;
  color: #999999;
  margin-left: auto;
}

.dish-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-name {
  font-size: 28rpx;
  color: #333333;
}

.dish-thumb {
  width: 60rpx;
  height: 60rpx;
  border-radius: 6rpx;
}

.note-input {
  width: 100%;
  height: 160rpx;
  background: #F9F9F9;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #BBBBBB;
  margin-top: 8rpx;
}

.result-banner {
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-banner.success {
  background: #E8F8EE;
  border: 1rpx solid #86C8A0;
}

.result-banner.success text:first-child {
  color: #1AAD19;
  font-size: 30rpx;
  font-weight: 500;
}

.result-banner.fail {
  background: #FFF0F0;
  border: 1rpx solid #E64340;
}

.result-banner.fail text:first-child {
  color: #E64340;
  font-size: 30rpx;
  font-weight: 500;
}

.hint {
  font-size: 24rpx;
  color: #666666;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
}

.back-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #F0F0F0;
  color: #666666;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.submit-btn {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background: #86C8A0;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
}